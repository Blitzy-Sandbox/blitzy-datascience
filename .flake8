[flake8]
# =============================================================================
# .flake8 — Lint Configuration for Validation Gate 2 (Clean-Lint Clause)
# =============================================================================
# Purpose
# -------
# This file is the single authoritative flake8 configuration for the NBA Data
# Ingestion Pipeline. It binds the following validation gate from the product
# brief (`docs/New_Product_Prompt_20260418.md` §6):
#
#   Gate 2 — Zero-Warning Build:
#     `python -m py_compile` on every `.py` file MUST produce zero warnings.
#     `flake8` or `ruff` with default rules MUST pass clean.
#
# Agent Action Plan references
# ----------------------------
#   §0.5.1.1 — Mandates `max-line-length = 120` to accommodate the narrative
#              tables and type-annotated pipeline signatures (e.g.,
#              `def run(client: NBAClient, writer: BaseWriter,
#              checkpoint: CheckpointManager, season: str) -> List[Path]:`)
#              that otherwise require awkward line breaks at the default 79.
#   §0.3.2.2 — Establishes this file as the canonical lint configuration and
#              selects `flake8>=6.0` (not `ruff`) as the project's dev
#              dependency. Any future switch to `ruff` would replace this
#              file with `ruff.toml`.
#   §0.7.2.2 — Rule 2 (Rate Limiting), §0.7.2.4 Rule 4 (Flat CSV), and
#              §0.7.2.7 Rule 7 (Pluggable Storage) are enforced by
#              `tests/invariants/` rather than by flake8; this config is
#              intentionally silent on those invariants.
#
# Maintenance contract
# --------------------
# Do NOT introduce a `select =` key: that would OVERRIDE the default
# ruleset and violate Gate 2's "default rules" clause. Only `extend-select`
# and `extend-ignore` are permitted — they ADD TO the defaults rather than
# replace them. Similarly, do NOT add `per-file-ignores` for production
# modules; if tests or invariant suites require a targeted ignore it is
# declared below and explained in a comment.
#
# Format note
# -----------
# flake8 reads this file via `configparser`, which treats `#` only at the
# start of a physical line as a comment. Inline comments after a value are
# NOT supported and will become part of the value. All clarifying prose is
# therefore placed on its own line above the key it describes.
# =============================================================================

# -----------------------------------------------------------------------------
# Line length
# -----------------------------------------------------------------------------
# The upstream default (79) is too narrow for the signatures produced by
# this project's dependency-injected pipelines (`NBAClient`, `BaseWriter`,
# `CheckpointManager`, optional `season: str`, return `List[Path]`). Raising
# the ceiling to 120 preserves readability without softening discipline —
# lines that genuinely need to exceed 120 characters should be refactored
# rather than suppressed with a `# noqa: E501`.
max-line-length = 120

# -----------------------------------------------------------------------------
# Path exclusions
# -----------------------------------------------------------------------------
# `extend-exclude` ADDS to flake8's built-in default exclusion set
# (which already covers `.git`, `__pycache__`, `.tox`, `.eggs`, `*.egg`,
# `.nox`, `.venv`, and a few legacy VCS directories). The additions below
# mirror `.gitignore` so that no artifact generated by a pipeline run can
# be linted by mistake, and cover project-specific directories that are
# not in the upstream default set.
#
# Pattern notes:
#   - `.venv*` catches alternative virtualenv naming such as `.venv-3.12`.
#   - `output/` and `logs/` are runtime artifact directories created by the
#     pipeline; they must never contain Python source.
#   - `.pytest_cache`, `.hypothesis`, and `htmlcov` are test-tooling caches.
#   - `blitzy/` is a tooling workspace owned by the Blitzy platform
#     (screenshots, operational scratch) and contains no Python modules.
#   - `docs/executive-summary.html` is a single-file reveal.js deck; it is
#     not Python, so flake8 would skip it by default, but listing it here
#     is defense in depth against future file-type filter regressions.
#
# Duplicates of upstream defaults (`.git`, `__pycache__`, `.venv`, etc.) are
# intentionally retained so the contract is self-contained and survives
# future flake8 default-set changes.
extend-exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .tox,
    .nox,
    .venv,
    .venv*,
    venv,
    env,
    ENV,
    build,
    dist,
    *.egg-info,
    *.egg,
    .eggs,
    output,
    logs,
    blitzy,
    htmlcov,
    .hypothesis,
    docs/executive-summary.html

# -----------------------------------------------------------------------------
# Rule adjustments
# -----------------------------------------------------------------------------
# `extend-ignore` ADDS to flake8's default ignored-rule set (which is empty
# by default when no `ignore =` key is present). Only two rules are disabled,
# both because they conflict with the modern PEP 8 consensus:
#
#   E203 — "whitespace before ':'":
#     PEP 8 and Black disagree on this rule for slice operations.
#     Black's convention, `x[1 : n - 1]`, is the de facto standard for
#     modern Python projects; E203 flags it as a violation. This project
#     follows Black's convention even though Black itself is not run
#     (adding a formatter is out of scope per AAP §0.3.2.1).
#
#   W503 — "line break before binary operator":
#     PEP 8 was updated in 2016 to recommend breaking BEFORE the operator
#     for readability (the "Knuth style"). W503 pre-dates that update and
#     flags the now-recommended style. Following the post-2016 PEP 8
#     guidance, we silence W503; the complementary code W504 (line break
#     AFTER operator, which some teams prefer) is left active by default.
#
# No other `E`, `F`, `W`, `C`, or `N` codes are disabled. The "default
# rules" clause of Gate 2 is preserved in full.
extend-ignore =
    E203,
    W503

# -----------------------------------------------------------------------------
# Complexity ceiling
# -----------------------------------------------------------------------------
# McCabe cyclomatic-complexity limit per function, enforced by the
# `mccabe` plugin bundled with flake8. A function exceeding this ceiling
# emits `C901: '<name>' is too complex (<value>)` and blocks Gate 2.
#
# The ceiling is calibrated against the expected shape of
# `pipelines/ingest_games.py::run()`, which combines:
#   - `GAME_ID` enumeration (Rule 6 prerequisite)
#   - per-game try/except fail-safe iteration (Rule 6)
#   - checkpoint lookup / mark_completed (Rule 5)
#   - rate-limit-aware logging (Rule 2 adjacency)
#   - per-endpoint branching (boxscoretraditionalv2, boxscoreadvancedv2,
#     playbyplayv2)
#
# Twelve gives modest headroom over this expected shape without allowing
# genuine complexity drift. If a function genuinely needs more than 12
# paths, the correct response is to refactor it (extract helpers, split
# by domain) rather than raise this ceiling.
max-complexity = 12

# -----------------------------------------------------------------------------
# Reporter output
# -----------------------------------------------------------------------------
# `show-source` prints the offending source line beneath each error so
# that Gate 2 failures in automated contexts (CI logs, `--tee` captures,
# operator terminals) are self-diagnosable without the reader needing to
# open the file in a separate editor buffer.
#
# `statistics` prints a summary count of each error code at the end of a
# run — invaluable when triaging whether a Gate 2 failure is one code
# firing many times (usually a formatting issue) versus many distinct
# codes firing once each (usually a semantic regression).
show-source = True
statistics = True
