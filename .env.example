# NBA Data Ingestion Pipeline — Operator Override Reference
# ---------------------------------------------------------
# This file is a REFERENCE. The authoritative defaults live in config.py.
# It is NOT loaded automatically; the project does not depend on
# python-dotenv (per AAP §0.3.1 — only the sanctioned library set is
# permitted). Set any of these variables in your shell BEFORE invoking
# `python run.py ...` to override the corresponding config.py default at
# runtime. Variables left unset fall back to the config.py defaults.
#
# Usage patterns:
#   1. Inspect this file to discover what is tunable.
#   2. Export a variable in your shell and run the CLI:
#        export NBA_LOG_LEVEL=DEBUG
#        python run.py all --season 2025-26
#   3. Or copy this file to `.env` and source it:
#        cp .env.example .env
#        set -a; source .env; set +a
#        python run.py all --season 2025-26
#      (or use direnv / a shell hook). `.env` itself is gitignored;
#      `.env.example` IS committed so new contributors immediately see
#      the full override surface.
#
# NOTE: env-var overrides are read ONCE at module load time of config.py.
# Changing a variable after the first `import config` has no effect. This
# is documented behaviour, not a bug.
#
# WARNING: do NOT reduce NBA_RATE_LIMIT_SECONDS below 1.0 — that would
# violate Rule 2 and almost certainly trigger HTTP 429 responses from the
# NBA Stats API, invalidating Validation Gate 8 ("zero 429 responses").
#
# WARNING: do NOT commit secrets to this file or to `.env`. The NBA Stats
# API is unauthenticated; this project has no secret surface.

# ---------------------------------------------------------------------------
# Upstream API
# ---------------------------------------------------------------------------

# NBA Stats API base URL (should rarely change; the base path is stable)
NBA_API_BASE_URL=https://stats.nba.com/stats/

# Per-request HTTP timeout in seconds (propagated into requests.get(..., timeout=))
NBA_REQUEST_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Rate limiting (Rule 2)
# ---------------------------------------------------------------------------

# Minimum inter-request delay in seconds. Rule 2 — DO NOT set below 1.0.
NBA_RATE_LIMIT_SECONDS=1.0

# ---------------------------------------------------------------------------
# Retry tuning (Feature F-004 / Rule 2 companion controls)
# ---------------------------------------------------------------------------

# tenacity stop-after-attempt count before raising the final exception
NBA_RETRY_ATTEMPTS=5

# tenacity exponential back-off multiplier
NBA_RETRY_MULTIPLIER=2

# tenacity exponential back-off ceiling in seconds
NBA_RETRY_MAX_WAIT=60

# tenacity exponential back-off floor in seconds
NBA_RETRY_MIN_WAIT=1

# ---------------------------------------------------------------------------
# Filesystem paths (relative to repository root or absolute)
# ---------------------------------------------------------------------------

# Directory for flat CSV output artifacts (AAP §0.6.1.7)
NBA_OUTPUT_DIR=output

# JSON manifest tracking completed (domain, key) pairs (Rule 5)
NBA_CHECKPOINT_PATH=output/checkpoint.json

# Directory for rotating log files
NBA_LOG_DIR=logs

# Primary log sink path (rotating file handler target)
NBA_LOG_FILE=logs/pipeline.log

# ---------------------------------------------------------------------------
# Logging (Feature F-008 / Observability rule)
# ---------------------------------------------------------------------------

# Root logger level: one of DEBUG, INFO, WARNING, ERROR, CRITICAL
NBA_LOG_LEVEL=INFO

# Rotation size threshold in bytes (default: 10485760 = 10 MiB)
NBA_LOG_FILE_MAX_BYTES=10485760

# Number of rotated backup log files retained
NBA_LOG_FILE_BACKUP_COUNT=5

# ---------------------------------------------------------------------------
# Season and league defaults (consumed by endpoints/*.py and run.py --season)
# ---------------------------------------------------------------------------

# Default season string consumed by every pipeline's --season flag (e.g. 2025-26)
NBA_DEFAULT_SEASON=2025-26

# Default season type. Quoted because the value contains a space.
# Other valid values: "Playoffs", "Pre Season", "All Star".
NBA_DEFAULT_SEASON_TYPE="Regular Season"

# NBA League ID: "00" for NBA, "10" for WNBA, "20" for G-League
NBA_DEFAULT_LEAGUE_ID=00

