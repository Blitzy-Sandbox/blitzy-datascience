.cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Runtime artifacts produced by this project (AAP §0.6.1.7)
output/
logs/
*.log

# Environment files (tracked template .env.example is intentionally NOT ignored per AAP §0.6.1.4)
.env
.env.local
.env.*.local

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter / notebooks (defensive; not used, but prevents accidental commit)
.ipynb_checkpoints/
